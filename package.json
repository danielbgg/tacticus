{
  "name": "personal-chess-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2",
    "@tanstack/react-router": "^1",
    "@tanstack/react-query": "^5",
    "zustand": "^5",
    "framer-motion": "^11",
    "react-hook-form": "^7",
    "zod": "^3",
    "chess.js": "^1",
    "react-chessboard": "^4",
    "react-i18next": "^15",
    "i18next": "^24",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "tailwind-merge": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2",
    "tailwindcss": "^4",
    "@tailwindcss/vite": "^4",
    "vitest": "^2",
    "@vitest/coverage-v8": "^2",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@testing-library/jest-dom": "^6",
    "jsdom": "^25",
    "playwright": "^1.45",
    "@playwright/test": "^1.45",
    "eslint": "^9",
    "typescript-eslint": "^8",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-import": "^2",
    "eslint-config-prettier": "^9",
    "prettier": "^3",
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "lefthook": "^1.6",
    "lint-staged": "^15",
    "@types/node": "^22",
    "node-sqlite3-wasm": "^0.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
